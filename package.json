{
  "name": "bigosheet",
  "version": "2.0.0",
  "private": true,
  "description": "Interactive Big O cheat sheet for DSA and coding interviews, built with Next.js.",
  "license": "MIT",
  "author": "Aryan Kumar (https://github.com/aryanjsx)",
  "repository": {
    "type": "git",
    "url": "https://github.com/aryanjsx/BigOSheet.git"
  },
  "homepage": "https://aryanjsx.github.io/BigOSheet/",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/flatten-prefetch.mjs",
    "start": "npx serve@latest out",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "vitest run tests/content.test.ts",
    "check-links": "node scripts/check-links.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run check-links"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
