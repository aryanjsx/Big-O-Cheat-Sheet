+.skip-link:focus { top: .5rem; }
+button:focus-visible, select:focus-visible, input:focus-visible, textarea:focus-visible, [tabindex]:focus-visible, dialog:focus-visible,
+.lang-tab:focus-visible, .quiz-opt:focus-visible, .card:focus-visible {
+  outline: 3px solid var(--link); outline-offset: 2px;
+}
