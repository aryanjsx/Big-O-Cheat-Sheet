+
+/* ---------- Shared controls ---------- */
+.btn-sm { font-size: .8rem; padding: .15rem .55rem; }
+.btn[aria-pressed="true"]::before { content: "\2713\00a0"; }
+.pg-controls { display: flex; flex-wrap: wrap; gap: .6rem 1rem; align-items: end; margin: 1rem 0 .5rem; }
+.pg-field { display: flex; flex-direction: column; gap: .2rem; min-width: 9rem; }
+.pg-field label { font-size: .85rem; font-weight: 600; }
+.pg-field select, .pg-field input[type="number"], .pg-field input[type="search"], .lookup input[type="search"] {
+  font: inherit; padding: .4rem .5rem; background: var(--surface); color: var(--text); border: 1px solid var(--border); border-radius: 4px;
+}
+.pg-field input[type="range"] { accent-color: var(--link); width: 14rem; max-width: 100%; }
+.viz-buttons { display: flex; flex-wrap: wrap; gap: .5rem; margin: .5rem 0; }
+.section-lede { max-width: 72ch; }
+
+/* ---------- Card additions ---------- */
+.card-actions { display: flex; flex-wrap: wrap; gap: .35rem; margin: .1rem 0 .5rem; }
+.card.is-learned { border-left: 4px solid var(--c-green); }
+.card.is-target { outline: 3px solid var(--link); outline-offset: 2px; }
+.lang-tabs { display: flex; flex-wrap: wrap; gap: .25rem; margin: .6rem 0 0; border-bottom: 1px solid var(--border); }
+.lang-tab { font: inherit; font-size: .85rem; padding: .3rem .7rem; background: transparent; color: var(--muted); border: 1px solid transparent; border-bottom: none; border-radius: 4px 4px 0 0; cursor: pointer; }
+.lang-tab[aria-selected="true"] { color: var(--text); background: var(--code-bg); border-color: var(--border); font-weight: 600; }
+.lang-tabs + .code-wrap pre { margin-top: 0; border-top-left-radius: 0; }
+.lang-note { font-size: .88rem; color: var(--muted); margin: .4rem 0 0; }
+#resume { margin: .5rem 0; font-size: .95rem; }
+#resume:empty { display: none; }
+
+/* ---------- Lookup ---------- */
+.lookup { max-width: 52rem; }
+.lookup label { display: block; font-size: .85rem; font-weight: 600; margin-bottom: .2rem; }
+.lookup input[type="search"] { width: 100%; }
+.lookup-list { list-style: none; margin: .4rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: .35rem; max-width: none; }
+.lookup-list li { cursor: pointer; font-size: .88rem; padding: .2rem .6rem; border: 1px solid var(--border); border-radius: 999px; background: var(--surface); }
+.lookup-list li[aria-selected="true"] { background: var(--link); color: var(--bg); border-color: var(--link); }
+.lookup-list li.is-active { outline: 2px solid var(--link); outline-offset: 1px; }
+.lookup-group { margin-left: .4rem; font-size: .75rem; opacity: .75; }
+.lookup-detail { margin-top: 1rem; }
+.lookup-detail .links { display: flex; flex-wrap: wrap; gap: .5rem 1rem; align-items: center; margin-top: .6rem; font-size: .92rem; }
+.lookup-table th[scope="row"] { text-align: left; width: 11rem; }
+.lookup-table td { text-align: left; }
+
+/* ---------- Roadmap ---------- */
+.progress-summary { margin: .5rem 0 .25rem; font-weight: 600; }
+.progress-bar { height: .6rem; background: var(--stripe); border: 1px solid var(--border); border-radius: 999px; overflow: hidden; max-width: 40rem; }
+.progress-fill { height: 100%; width: 0; background: var(--c-green); }
+.roadmap { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1rem; margin-top: 1rem; align-items: start; }
+.road-level { background: var(--surface); border: 1px solid var(--border); border-radius: 4px; padding: .9rem 1rem; }
+.road-level h3 { margin: 0 0 .15rem; font-size: 1.15rem; }
+.road-blurb { margin: 0 0 .5rem; color: var(--muted); font-size: .9rem; }
+.road-steps { margin: 0; padding-left: 1.4rem; max-width: none; }
+.road-step { padding: .3rem 0; border-top: 1px solid var(--border); }
+.road-step:first-child { border-top: none; }
+.road-row { display: flex; gap: .5rem; align-items: baseline; flex-wrap: wrap; }
+.road-row label { font-weight: 600; flex: 1 1 8rem; cursor: pointer; }
+.road-row input { accent-color: var(--c-green); }
+.road-open { font-size: .82rem; }
+.road-meta { margin: .1rem 0 0; font-size: .82rem; color: var(--muted); max-width: none; }
+.road-step.is-learned .road-row label { text-decoration: line-through; text-decoration-thickness: 1px; color: var(--muted); }
+.road-step.is-ready::marker { color: var(--c-green); font-weight: 700; }
+.road-meta span { display: block; }
+.road-step.is-ready .road-meta::before { content: "Ready to learn"; display: block; font-weight: 600; color: var(--green-fg); }
+
+/* ---------- Playground ---------- */
+.pg-toggles { border: 1px solid var(--border); border-radius: 4px; padding: .3rem .8rem .5rem; margin: .5rem 0; display: flex; flex-wrap: wrap; gap: .3rem 1rem; }
+.pg-toggles legend { font-size: .85rem; font-weight: 600; padding: 0 .3rem; }
+.pg-toggle { display: inline-flex; align-items: center; gap: .35rem; cursor: pointer; }
+.pg-toggle input { accent-color: var(--link); }
+.pg-toggle code { padding: .05rem .4rem; border-radius: 3px; }
+.pg-note { min-height: 1.4em; color: var(--muted); font-size: .88rem; margin: 0 0 .5rem; }
+.pg-name { display: block; font-size: .85rem; color: var(--muted); }
+.pg-bar { display: block; height: .35rem; margin-top: .25rem; background: var(--stripe); border-radius: 2px; overflow: hidden; }
+.pg-bar-fill { display: block; height: 100%; border-radius: 2px; }
+.chart .curve { stroke-linecap: round; }
+
+/* ---------- Visualizer ---------- */
+.viz { margin: 1rem 0; }
+.viz-meta { margin: .25rem 0 .5rem; font-size: .92rem; max-width: none; }
+.viz-stage svg { max-height: 360px; }
+.viz-msg { min-height: 2.9em; margin: .5rem 0 .1rem; font-size: 1rem; max-width: none; }
+.viz-stats, .viz-list, .viz-progress { margin: .1rem 0; font-size: .88rem; color: var(--muted); max-width: none; white-space: pre-wrap; }
+.viz-list:empty { display: none; }
+.viz-legend { list-style: none; margin: .5rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: .25rem 1rem; font-size: .85rem; max-width: none; }
+.viz-legend li { display: inline-flex; align-items: center; gap: .35rem; }
+.viz-sw { display: inline-block; width: .9rem; height: .9rem; border-radius: 2px; border: 2px solid var(--role-stroke, var(--border)); background: var(--role-fill, var(--c-gray)); }
+
+:where(.viz-svg .viz-item) { --role-fill: var(--c-gray); --role-stroke: var(--c-gray); --role-bg: var(--stripe); --role-fg: var(--text); }
+.viz-compare { --role-fill: var(--c-yellow); --role-stroke: var(--yellow-fg); --role-bg: var(--yellow-bg); --role-fg: var(--yellow-fg); }
+.viz-swap    { --role-fill: var(--c-red);    --role-stroke: var(--red-fg);    --role-bg: var(--red-bg);    --role-fg: var(--red-fg); }
+.viz-range   { --role-fill: var(--link);     --role-stroke: var(--link);      --role-bg: var(--code-bg);   --role-fg: var(--text); }
+.viz-mid     { --role-fill: var(--c-orange); --role-stroke: var(--orange-fg); --role-bg: var(--orange-bg); --role-fg: var(--orange-fg); }
+.viz-sorted, .viz-done  { --role-fill: var(--c-green); --role-stroke: var(--green-fg); --role-bg: var(--green-bg); --role-fg: var(--green-fg); }
+.viz-found   { --role-fill: var(--c-green);  --role-stroke: var(--green-fg);  --role-bg: var(--green-bg);  --role-fg: var(--green-fg); }
+.viz-frontier{ --role-fill: var(--c-yellow); --role-stroke: var(--yellow-fg); --role-bg: var(--yellow-bg); --role-fg: var(--yellow-fg); }
+.viz-current { --role-fill: var(--link);     --role-stroke: var(--link);      --role-bg: var(--link);      --role-fg: var(--bg); }
+.viz-out     { --role-fill: var(--c-gray);   --role-stroke: var(--border);    --role-bg: var(--surface);   --role-fg: var(--muted); }
+
+.viz-kind-bars .viz-item rect { fill: var(--role-fill); stroke: none; }
+.viz-kind-bars .viz-compare rect { stroke: var(--role-stroke); stroke-width: 2; stroke-dasharray: 4 2; }
+.viz-kind-bars .viz-swap rect { stroke: var(--role-stroke); stroke-width: 3; }
+.viz-kind-cells .viz-item rect, .viz-kind-graph .viz-item circle { fill: var(--role-bg); stroke: var(--role-stroke); stroke-width: 2; }
+.viz-kind-cells .viz-compare rect, .viz-kind-graph .viz-frontier circle { stroke-dasharray: 5 3; }
+.viz-kind-cells .viz-mid rect, .viz-kind-cells .viz-found rect, .viz-kind-graph .viz-current circle { stroke-width: 4; }
+.viz-kind-cells .viz-out { opacity: .5; }
+.viz-num { fill: var(--text); font-size: 12px; font-weight: 600; }
+.viz-num-in { fill: var(--role-fg); font-size: 18px; }
+.viz-idx { fill: var(--muted); font-size: 11px; }
+.viz-target { fill: var(--text); font-size: 16px; font-weight: 600; }
+.viz-edge { stroke: var(--border); stroke-width: 2; }
+
+/* ---------- Quiz and challenge ---------- */
+.quiz, .challenge, .compare, .export { max-width: 52rem; }
+.quiz-count { font-size: .9rem; color: var(--muted); margin: .5rem 0; }
+.quiz-q { border: none; padding: 0; margin: 0 0 .5rem; min-width: 0; }
+.quiz-q legend { font-weight: 600; margin-bottom: .25rem; padding: 0; }
+.quiz-opts { display: grid; gap: .5rem; margin-top: .6rem; }
+.quiz-opt { display: flex; gap: .75rem; align-items: baseline; text-align: left; font: inherit; padding: .55rem .8rem; background: var(--surface); color: var(--text); border: 1px solid var(--border); border-radius: 4px; cursor: pointer; }
+.quiz-opt:hover:not(:disabled) { border-color: var(--link); }
+.quiz-key { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: .8rem; padding: 0 .4rem; border: 1px solid var(--border); border-radius: 3px; color: var(--muted); }
+.quiz-opt.is-correct { background: var(--green-bg); color: var(--green-fg); border-color: var(--c-green); opacity: 1; }
+.quiz-opt.is-wrong { background: var(--red-bg); color: var(--red-fg); border-color: var(--c-red); opacity: 1; }
+.quiz-opt:disabled:not(.is-correct):not(.is-wrong) { opacity: .6; }
+.quiz-flag { margin-left: auto; font-size: .8rem; font-weight: 600; }
+.quiz-feedback { margin: .75rem 0; max-width: 72ch; }
+.quiz-feedback:empty { display: none; }
+.quiz-feedback p { margin: .25rem 0; }
+.quiz-review { padding-left: 1.2rem; max-width: none; }
+.quiz-review li { margin: .75rem 0; }
+.challenge-form { display: flex; flex-wrap: wrap; gap: .75rem 1rem; align-items: end; margin: .75rem 0; }
+
+/* ---------- Compare and export ---------- */
+.compare-table th[scope="row"] { text-align: left; width: 10rem; }
+.compare-table td.notes { min-width: 14rem; }
+.compare .callout { margin-top: .5rem; }
+
+/* ---------- Shortcuts dialog ---------- */
+dialog.shortcuts { max-width: 34rem; width: calc(100% - 2rem); background: var(--surface); color: var(--text); border: 1px solid var(--border); border-radius: 6px; padding: 1rem 1.25rem; }
+dialog.shortcuts::backdrop { background: rgba(0, 0, 0, .5); }
+.shortcut-list { display: grid; grid-template-columns: auto 1fr; gap: .4rem 1rem; margin: 0 0 1rem; }
+.shortcut-list dt { font-weight: 600; white-space: nowrap; }
+.shortcut-list dd { margin: 0; color: var(--muted); }
+kbd { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: .85em; padding: .05rem .4rem; background: var(--code-bg); border: 1px solid var(--border); border-bottom-width: 2px; border-radius: 3px; }
+.hint { font-size: .85rem; color: var(--muted); }
+
+/* ---------- Print: topic cards ---------- */
+#print-cards { display: none; }
+@media print {
+  .interactive, .skip-link, dialog, .card-actions, .lang-tabs, #resume { display: none !important; }
+  #playground-mount .pg-controls, #playground-mount .pg-toggles, #playground-mount .pg-note, .pg-bar { display: none !important; }
+  body.print-cards #full-view, body.print-cards #revision-sheet, body.print-cards .toc, body.print-cards .toolbar, body.print-cards h1, body.print-cards .lede { display: none !important; }
+  body.print-cards #print-cards { display: block; }
+  #print-cards .pc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8pt; }
+  #print-cards .pc { border: .75pt solid #666; padding: 6pt 8pt; break-inside: avoid; font-size: 8pt; }
+  #print-cards .pc h3 { font-size: 10.5pt; margin: 0 0 2pt; }
+  #print-cards .pc-meta { margin: 0 0 3pt; color: #333; }
+  #print-cards .pc p { margin: 2pt 0; }
+  #print-cards .pc dl { display: grid; grid-template-columns: auto 1fr; gap: 0 6pt; margin: 2pt 0; }
+  #print-cards .pc dt { font-weight: 700; }
+  #print-cards .pc dd { margin: 0; }
+  #print-cards .pc pre { font-size: 6.5pt; padding: 3pt 4pt; margin: 3pt 0 0; white-space: pre-wrap; }
+}
+
+/* ---------- Narrow screens ---------- */
+/* The section nav grew with the new features. Keep it to one scrolling row on phones
+   so it does not cover a third of the screen while you read. */
+@media (max-width: 760px) {
+  html { scroll-padding-top: 3.2rem; }
+  .toc { flex-wrap: nowrap; overflow-x: auto; white-space: nowrap; gap: 1rem; scrollbar-width: thin; }
+  .toc a { flex: 0 0 auto; padding: .4rem 0; }
+  .pg-field input[type="range"] { width: 100%; }
+  .pg-field { flex: 1 1 8rem; }
+}
+@media print { .toc { display: none !important; } }
